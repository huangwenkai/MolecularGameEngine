        (id: "coin",      name: "金币",     slot: Trinket, stack: 65000, value: 1),
    ],

    // 词缀池（prefix 前缀 / 后缀；数值 = min+rand*(max-min) + per_lvl*(ilvl-1)）
    affixes: [
        (id: "sharp",  name: "锋利", stat: DmgFlat,  min: 2.0,  max: 6.0,  per_lvl: 0.8, prefix: true),
        (id: "heavy",  name: "沉重", stat: DmgPct,   min: 6.0,  max: 12.0, per_lvl: 0.6, prefix: true),
        (id: "swift",  name: "迅捷", stat: AtkPct,   min: 4.0,  max: 10.0, per_lvl: 0.4, prefix: true),
        (id: "keen",   name: "精准", stat: Crit,     min: 2.0,  max: 6.0,  per_lvl: 0.2, prefix: true),
        (id: "sturdy", name: "坚固", stat: Armor,    min: 1.0,  max: 4.0,  per_lvl: 0.5, prefix: false),
        (id: "vital",  name: "活力", stat: MaxHp,    min: 8.0,  max: 20.0, per_lvl: 1.2, prefix: false),
        (id: "light",  name: "轻盈", stat: MovePct,  min: 3.0,  max: 8.0,  per_lvl: 0.2, prefix: false),
        (id: "cruel",  name: "残忍", stat: CritDmg,  min: 8.0,  max: 20.0, per_lvl: 0.6, prefix: false),
    ],

    // 掉落表：chance 过滤 → weight 抽 1 条
    tables: {
